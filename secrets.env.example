# Copy to secrets.env (never committed) and fill in. Keys use ASP.NET's double underscore, so they
# override the empty values in appsettings.json without any code reading them.

# Over Tailscale, as the smarthomeproxy NATS user. The password is NATS_SMARTHOMEPROXY_PASSWORD in
# the server's secrets.env; both have to change together.
Nats__Url=nats://smarthomeproxy:<password>@100.86.14.1:4222

HomeAssistant__BaseUrl=http://<home-assistant>:8123
HomeAssistant__AccessToken=

Cloud__BaseUrl=https://smarthome.hannescloud.net
Cloud__OwnerUserId=
Cloud__Auth0__Domain=
Cloud__Auth0__ClientId=
Cloud__Auth0__ClientSecret=
Cloud__Auth0__Audience=
