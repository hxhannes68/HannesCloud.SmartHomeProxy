# /etc/pi-sensor.env, readable by the user running bme280.service:
#   sudo chown root:hannes /etc/pi-sensor.env && sudo chmod 640 /etc/pi-sensor.env
# Read before every send, so changes apply from the next reading on, without a restart.

# The Mac mini running the proxy, port from compose.yaml.
PROXY_URL=http://MinivonJohannes.local:8095
# LocalSensors__ApiKey from the proxy's secrets.env.
API_KEY=

# Names this Pi's entities (sensor.pi1_temperature, …). Keep it when the Pi moves.
DEVICE=pi1
# The room as it is called in the app. Change this when the Pi moves; the cloud follows.
ROOM=Wohnzimmer
